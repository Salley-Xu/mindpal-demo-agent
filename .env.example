# ============================================================
# MindPal Pro — 环境配置模板
# ============================================================
# 使用方法：
#   1. 复制此文件到 backend/.env
#        cp .env.example backend/.env   (Linux/macOS)
#        copy .env.example backend/.env  (Windows)
#   2. 填入你的 DeepSeek API Key
#   3. 按需调整其他配置
# ============================================================

# ==================== API 密钥（必填） ====================
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
CHAT_MODEL=deepseek-chat
API_BASE_URL=https://api.deepseek.com/v1

# ==================== 服务器 ====================
HOST=0.0.0.0
PORT=8000

# ==================== 应用 ====================
APP_NAME=MindPal Pro Backend
APP_VERSION=3.2
LOG_LEVEL=INFO

# ==================== 对话 ====================
MAX_HISTORY=20
SESSION_TIMEOUT=30
MAX_CONTEXT_TOKENS=2400

# ==================== 会话持久化 ====================
SESSION_PERSISTENCE_ENABLED=true
SESSION_DB_PATH=data/sessions.db
SESSION_CLEANUP_DAYS=30

# ==================== 内容数据库 ====================
CONTENT_DB_FILE=data/content_db.json

# ==================== CORS ====================
ALLOWED_ORIGINS=*

# ==================== API 安全 ====================
API_AUTH_TOKEN=
# 生产环境建议设为 true；API_AUTH_TOKEN 代表管理员令牌。
API_AUTH_REQUIRED=false
# 用户级令牌映射，例如 {"token-user-a":"user-a"}
API_USER_TOKENS_JSON={}

# ==================== BERT 风险预测 ====================
BERT_MODEL_PATH=bert_data/models/v4_2_domain_only_v2/best_model
BERT_DEVICE=cpu
BERT_BINARY_THRESHOLD=0.50

# ==================== BERT 情绪分类 ====================
USE_BERT_EMOTION=true
EMOTION_MODEL_PATH=bert_data/models/emotion_v1/best_model
EMOTION_DEVICE=cpu
EMOTION_CONFIDENCE_THRESHOLD=0.6

# ==================== 推荐 ====================
ENABLE_RECOMMEND_AI_RERANK=true
RECOMMEND_RERANK_CANDIDATE_SIZE=10
RECOMMEND_GATE_EMOTION_WEIGHT=0.30
RECOMMEND_GATE_RISK_WEIGHT=0.23
RECOMMEND_GATE_INTENT_WEIGHT=0.23
RECOMMEND_GATE_TREND_WEIGHT=0.14
RECOMMEND_GATE_PREFERENCE_WEIGHT=0.10
RECOMMEND_GATE_HARD_THRESHOLD=0.58
RECOMMEND_GATE_SOFT_THRESHOLD=0.22

# ==================== 记忆系统 ====================
MEMORY_ENABLED=true
MEMORY_EMBEDDING_ENABLED=false
MEMORY_INJECTION_BUDGET_RATIO=0.15
MEMORY_MAX_ITEMS_PER_USER=500
MEMORY_RRF_K=60
MEMORY_DECAY_DAYS_MOOD_EVENT=90
MEMORY_DECAY_DAYS_STRESS_SOURCE=180
MEMORY_DECAY_DAYS_RISK_EVENT=30

# ==================== Risk Memory ====================
RISK_BASELINE_HIGH_WINDOW_DAYS=7
RISK_BASELINE_MEDIUM_WINDOW_DAYS=14
RISK_EVENT_DECAY_DAYS=30

# ==================== 定时任务 ====================
SESSION_CLEANUP_HOUR=3
SESSION_CLEANUP_MINUTE=0
